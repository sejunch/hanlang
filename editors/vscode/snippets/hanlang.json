{
  "만약": { "prefix": ["만약", "if"], "body": ["만약 (${1:조건}) 라면 {", "\t$0", "}"], "description": "조건" },
  "만약 아니면": { "prefix": ["만약아니면", "ifelse"], "body": ["만약 (${1:조건}) 라면 {", "\t$2", "} 아니면 {", "\t$0", "}"], "description": "조건 + 아니면" },
  "인 동안": { "prefix": ["동안", "while"], "body": ["(${1:조건}) 인 동안 {", "\t$0", "}"], "description": "조건 반복" },
  "번 반복하다": { "prefix": ["반복", "repeat"], "body": ["${1:10}번 반복하다 {", "\t$0", "}"], "description": "횟수 반복" },
  "목록 돌기": { "prefix": ["목록돌기", "for"], "body": ["${2:번호}는 1이다.", "(${2:번호} <= (${1:목록}의 개수)) 인 동안 {", "\t${3:값}은 (${1:목록}의 ${2:번호}번째)이다.", "\t$0", "\t${2:번호}는 (${2:번호} + 1)이다.", "}"], "description": "목록을 처음부터 끝까지" },
  "함수": { "prefix": ["함수", "func"], "body": ["${1:가}와 ${2:나}를 ${3:더하다} 란 {", "\t$0", "}"], "description": "함수 정의 (부르는 모양 그대로)" },
  "묶음": { "prefix": ["묶음", "struct"], "body": ["${1:학생} 이란 묶음 {", "\t${2:이름}은 ${3:문자}.", "\t$0", "}"], "description": "묶음(구조체) 정의" },
  "사전": { "prefix": ["사전", "dict"], "body": ["${1:점수표}는 (빈 ${2:정수} 사전)이다.", "${1:점수표}의 \"${3:철수}\"는 ${4:85}이다.$0"], "description": "사전 만들고 넣기" },
  "파일 읽기": { "prefix": ["파일읽기", "readfile"], "body": ["파일 \"${1:입력.txt}\"를 읽기로 열다 {", "\t(입력끝 == 거짓) 인 동안 {", "\t\t줄은 듣다.", "\t\t$0", "\t}", "} 못 열면 {", "\t\"파일을 못 열었음\"을 말하다.", "}"], "description": "파일을 한 줄씩 읽기" },
  "파일 쓰기": { "prefix": ["파일쓰기", "writefile"], "body": ["파일 \"${1:출력.txt}\"를 쓰기로 열다 {", "\t$0", "}"], "description": "파일에 쓰기 (블록 안의 말하다 가 파일로)" },
  "말하다": { "prefix": ["말하다", "print"], "body": ["${1:\"안녕\"}을 말하다."], "description": "출력" },
  "듣다": { "prefix": ["듣다", "input"], "body": ["${1:입력}은 듣다.", "${2:수}는 (${1:입력}을 정수로 바꾸다)이다."], "description": "입력 받아 정수로" },
  "불러오다": { "prefix": ["불러오다", "import"], "body": ["\"${1|수학,목록,문자,정렬,통계,격자,분수,큰수|}.han\"을 불러오다."], "description": "표준 라이브러리 불러오기" }
}
