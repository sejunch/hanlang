#!/usr/bin/env bash
# 한랭으로 짠 한랭 컴파일러(self/한랭.han)로 컴파일하고 실행:  self/han2 프로그램.han [인자...]
# 컴파일러 자체는 hanc 로 만든다. 런타임(쓰레기 수거·목록·사전·입출력)은 hanc --runtime 이 만든
# self/runtime.s — 셀프 컴파일러가 자기 옆에서 찾아 어셈블리 뒤에 붙인다.
set -e
dir=$(cd "$(dirname "$0")" && pwd)
src="$1"
if [ -z "$src" ]; then echo "사용법: self/han2 파일.han"; exit 1; fi
hanc="$dir/../hanc"
if [ ! -x "$dir/hanc2" ] || [ "$dir/한랭.han" -nt "$dir/hanc2" ] || [ "$hanc" -nt "$dir/hanc2" ]; then
    "$hanc" "$dir/한랭.han" -o "$dir/hanc2"
fi
if [ ! -f "$dir/runtime.s" ] || [ "$hanc" -nt "$dir/runtime.s" ]; then
    "$hanc" --runtime > "$dir/runtime.s"
fi
if [ ! -f "$dir/runtime-window.s" ] || [ "$hanc" -nt "$dir/runtime-window.s" ]; then
    "$hanc" --runtime-window > "$dir/runtime-window.s"       # 창 그리기를 쓰면 붙음 (-lX11 -lXft)
fi
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
# 셀프 컴파일러는 self/ 에 있어서 '컴파일러 옆 lib/' 가 저장소의 lib/ 가 아니다 — $HAN_LIB 로 알려준다
HAN_LIB="${HAN_LIB:-$dir/../lib}" "$dir/hanc2" "$src" -o "$tmp/p" || exit 1
shift
"$tmp/p" "$@"
