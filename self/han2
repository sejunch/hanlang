#!/usr/bin/env bash
# 한랭으로 짠 한랭 컴파일러(self/한랭.han)로 컴파일하고 실행:  self/han2 프로그램.han
# 컴파일러 자체는 hanc 로 만든다 (아직 자기 자신은 못 컴파일함 — 1단계)
set -e
dir=$(cd "$(dirname "$0")" && pwd)
src="$1"
if [ -z "$src" ]; then echo "사용법: self/han2 파일.han"; exit 1; fi
if [ ! -x "$dir/hanc2" ] || [ "$dir/한랭.han" -nt "$dir/hanc2" ]; then
    "$dir/../hanc" "$dir/한랭.han" -o "$dir/hanc2"
fi
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
"$dir/hanc2" "$src" "$tmp/p.s" || exit 1      # 오류면 표준 에러에 알리고 종료코드 1
gcc -no-pie "$tmp/p.s" -o "$tmp/p"
shift
"$tmp/p" "$@"
